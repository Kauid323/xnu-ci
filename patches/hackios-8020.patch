+	/*
+	 * (redwood) iOS 16 keeps this in processor_t::pr_recount and answers it with
+	 * recount_processor_usage(); 8020 has neither, so there is no idle time to report and the
+	 * caller (redwood_cpufreq.c) has to make do without it.
+	 */
+	(void)cpu_id;
+	(void)idle;
+	return false;
+}
