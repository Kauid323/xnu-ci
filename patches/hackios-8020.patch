+void
+thread_runnable_and_run_self(uint64_t *runnable, uint64_t *run)
+{
+	thread_t thread = current_thread();
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	uint64_t now = mach_absolute_time();
