diff --git a/EXTERNAL_HEADERS/corecrypto/cc_priv.h b/EXTERNAL_HEADERS/corecrypto/cc_priv.h
index 544813fadaea..ff6391d75151 100644
--- a/EXTERNAL_HEADERS/corecrypto/cc_priv.h
+++ b/EXTERNAL_HEADERS/corecrypto/cc_priv.h
@@ -224,6 +224,97 @@ x = (((uint64_t)(((const unsigned char *)(y))[0] & 255))<<56) |           \
 
 #endif
 
+// MARK: - Loads and Store
+//
+// (redwood) 8796 has this block in cc_priv.h and 8020 does not, so osfmk/minicrypto/
+// mc_digests.c ends up calling cc_load32_be() and friends without a declaration and the
+// kernel does not link (no libcorecrypto in this build -- minicrypto replaces it).
+// Written without 8796's cc_sized_by() annotations, which 8020's cc_config.h lacks.
+
+CC_INLINE void cc_store16_be(uint16_t x, uint8_t *y)
+{
+    y[0] = (uint8_t)(x >> 8);
+    y[1] = (uint8_t)(x);
+}
+CC_INLINE uint16_t cc_load16_be(const uint8_t *y)
+{
+    return (uint16_t)(((uint16_t)(y[0]) << 8) | ((uint16_t)(y[1])));
+}
+
+CC_INLINE void cc_store16_le(uint16_t x, uint8_t *y)
+{
+    y[0] = (uint8_t)(x);
+    y[1] = (uint8_t)(x >> 8);
+}
+CC_INLINE uint16_t cc_load16_le(const uint8_t *y)
+{
+    return (uint16_t)(((uint16_t)(y[1]) << 8) | ((uint16_t)(y[0])));
+}
+
+CC_INLINE void cc_store32_be(uint32_t x, uint8_t *y)
+{
+    y[0] = (uint8_t)(x >> 24);
+    y[1] = (uint8_t)(x >> 16);
+    y[2] = (uint8_t)(x >> 8);
+    y[3] = (uint8_t)(x);
+}
+CC_INLINE uint32_t cc_load32_be(const uint8_t *y)
+{
+    return (((uint32_t)(y[0])) << 24) | (((uint32_t)(y[1])) << 16) |
+           (((uint32_t)(y[2])) << 8) | ((uint32_t)(y[3]));
+}
+
+CC_INLINE void cc_store32_le(uint32_t x, uint8_t *y)
+{
+    y[0] = (uint8_t)(x);
+    y[1] = (uint8_t)(x >> 8);
+    y[2] = (uint8_t)(x >> 16);
+    y[3] = (uint8_t)(x >> 24);
+}
+CC_INLINE uint32_t cc_load32_le(const uint8_t *y)
+{
+    return (((uint32_t)(y[3])) << 24) | (((uint32_t)(y[2])) << 16) |
+           (((uint32_t)(y[1])) << 8) | ((uint32_t)(y[0]));
+}
+
+CC_INLINE void cc_store64_be(uint64_t x, uint8_t *y)
+{
+    y[0] = (uint8_t)(x >> 56);
+    y[1] = (uint8_t)(x >> 48);
+    y[2] = (uint8_t)(x >> 40);
+    y[3] = (uint8_t)(x >> 32);
+    y[4] = (uint8_t)(x >> 24);
+    y[5] = (uint8_t)(x >> 16);
+    y[6] = (uint8_t)(x >> 8);
+    y[7] = (uint8_t)(x);
+}
+CC_INLINE uint64_t cc_load64_be(const uint8_t *y)
+{
+    return (((uint64_t)(y[0])) << 56) | (((uint64_t)(y[1])) << 48) |
+           (((uint64_t)(y[2])) << 40) | (((uint64_t)(y[3])) << 32) |
+           (((uint64_t)(y[4])) << 24) | (((uint64_t)(y[5])) << 16) |
+           (((uint64_t)(y[6])) << 8) | ((uint64_t)(y[7]));
+}
+
+CC_INLINE void cc_store64_le(uint64_t x, uint8_t *y)
+{
+    y[0] = (uint8_t)(x);
+    y[1] = (uint8_t)(x >> 8);
+    y[2] = (uint8_t)(x >> 16);
+    y[3] = (uint8_t)(x >> 24);
+    y[4] = (uint8_t)(x >> 32);
+    y[5] = (uint8_t)(x >> 40);
+    y[6] = (uint8_t)(x >> 48);
+    y[7] = (uint8_t)(x >> 56);
+}
+CC_INLINE uint64_t cc_load64_le(const uint8_t *y)
+{
+    return (((uint64_t)(y[7])) << 56) | (((uint64_t)(y[6])) << 48) |
+           (((uint64_t)(y[5])) << 40) | (((uint64_t)(y[4])) << 32) |
+           (((uint64_t)(y[3])) << 24) | (((uint64_t)(y[2])) << 16) |
+           (((uint64_t)(y[1])) << 8) | ((uint64_t)(y[0]));
+}
+
